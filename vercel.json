{
  "version": 2,
  "framework": "nextjs",
  "installCommand": "npm install -g pnpm@10.34.9 && pnpm install --frozen-lockfile",
  "buildCommand": "next build",
  "builds": [
    {
      "src": "next.config.js",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/auth/(.*)",
      "dest": "/api/auth/[...nextauth]"
    }
  ]
}
